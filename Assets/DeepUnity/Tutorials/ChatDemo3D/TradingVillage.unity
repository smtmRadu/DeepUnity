  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1968099457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a36ddae7bc024447a9030ad96215059, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  strollerA: {fileID: 279264470}
  strollerB: {fileID: 62281130}
  bubbleA: {fileID: 64042814}
  bubbleB: {fileID: 1277005782}
  lines:
  - speaker: 0
    text: Fish again at Bram's stall. Third week running, I swear.
  - speaker: 1
    text: Better fish than nothing. The south road is mud to the knees.
  - speaker: 0
    text: Aye, the carters will not come till it dries. Salt costs double already.
  - speaker: 1
    text: And you will still buy it, you old goat. Your cabbage soup demands it.
  - speaker: 0
    text: My soup is famous, Fenn. Even the miller asks after it.
  - speaker: 1
    text: The miller asks after everything that is free.
  - speaker: 0
    text: Ha! True enough. At least the old girl back there never complains.
  - speaker: 1
    text: She is on a rope, Odo. She has no say in the matter.
  earshotRadius: 18
  linePause: 0.9
