# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# VS cache directory
.vs/
.vscode/
.vs
.vscode
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# copyrighted audio, personal use only - never commit
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/limgrave_theme.ogg
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/limgrave_theme.ogg.meta

# Claude Code editor bridge runtime files
ClaudeBridge/
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/boss_theme.ogg
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/boss_theme.ogg.meta
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/you_died.ogg
Assets/DeepUnity/Tutorials/ChatDemo3D/Art/Audio/you_died.ogg.meta

# dev/runtime artifacts - never commit
ProbeLogs/
Assets/Resources/Cache/
Assets/DeepUnity/ReinforcementLearning/Base/debug-*.log
Assets/DeepUnity/ReinforcementLearning/Base/debug-*.log.meta

# Model weights (LLM + TTS + STT) — large binaries regenerated via the param-export scripts
# (import_params.py / import_kokoro.py / import_qwen3asr.py / import_parakeet.py). All exports
# land flat under Assets/Resources/Weights/; intentionally NOT tracked (too large for git),
# EXCEPT the roleplay finetunes (not regenerable from HF — merged from our run4 adapter;
# every shard < 100 MB so plain git holds it). `/*` not `/` on the dir rule: git
# never descends into a fully-ignored directory, so the negations would be dead otherwise.
Assets/Resources/Weights/*
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_int8
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_int8/**
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_int8.meta
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_1308_int8
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_1308_int8/**
!Assets/Resources/Weights/weights_qwen3.5_0.8B_roleplay_1308_int8.meta
Assets/Resources/DeepUnity/
Assets/Resources/DeepUnity.meta
Assets/DeepUnity/InferenceEngine/LLM/**/weights_*/
Assets/DeepUnity/InferenceEngine/LLM/**/weights_*.meta
Assets/DeepUnity/InferenceEngine/LLM/**/params_*/
Assets/DeepUnity/InferenceEngine/LLM/**/params_*.meta
Assets/DeepUnity/InferenceEngine/TTS/**/weights_*/
Assets/DeepUnity/InferenceEngine/TTS/**/weights_*.meta
Assets/DeepUnity/InferenceEngine/TTS/**/params_*/
Assets/DeepUnity/InferenceEngine/TTS/**/params_*.meta

# Python bytecode caches from the param-export scripts.
**/__pycache__/
**/__pycache__.meta

# Temporary probe/parity scenes (throwaway, generated locally).
Assets/__*_tmp.unity
Assets/__*_tmp.unity.meta

# TTS/STT parity/reference tensor dumps — regenerated on-demand via dump_reference.py.
Assets/DeepUnity/InferenceEngine/TTS/validation/dump/
Assets/DeepUnity/InferenceEngine/TTS/validation/dump.meta
Assets/DeepUnity/InferenceEngine/TTS/*/validation/dump/
Assets/DeepUnity/InferenceEngine/TTS/*/validation/dump.meta
Assets/DeepUnity/InferenceEngine/STT/*/validation/dump/
Assets/DeepUnity/InferenceEngine/STT/*/validation/dump.meta

# dotnet build artifacts of the Unity-ignored (~) validation harnesses
Assets/DeepUnity/**/harness~/obj/
Assets/DeepUnity/**/harness~/bin/

# local editor batch-build logs
/chatdemo2d_*.log
unsloth_compiled_cache/

# AnyaChatDemo (archived): Rocketbox source art (~100 MB, MIT) — intentionally NOT tracked.
# Re-download instructions: Assets/DeepUnity/Tutorials/AnyaChatDemo/ARCHIVED.md
Assets/DeepUnity/Tutorials/AnyaChatDemo/Art/Female_Adult_01/Export/
Assets/DeepUnity/Tutorials/AnyaChatDemo/Art/Female_Adult_01/Export.meta
Assets/DeepUnity/Tutorials/AnyaChatDemo/Art/Female_Adult_01/Textures/f001_*

# local-only: NVIDIA Audio2Face port staging (model weights, ~300 MB) + ad-hoc bench scripts
/A2FPort/
/run_bench_*.sh

# Dissertation working docs (paper drafts, LaTeX/PDF) - kept out of the repo
/Docs/dissertation/
/Docs/dissertation.meta
